{
    "manifest_version": 3,
    "name": "Steam Revenue Estimator",
    "version": "0.1.0",
    "description": "Shows an estimated revenue range on Steam store pages, based on review counts.",
    "permissions": ["storage"],
    "host_permissions": ["https://api.steampowered.com/*"],
    "background": {
        "service_worker": "dist/background.js"
    },
    "options_page": "options.html",
    "content_scripts": [
        {
            "matches": ["https://store.steampowered.com/app/*"],
            "js": ["dist/settings.js", "dist/estimator.js", "dist/ui.js", "dist/tracking.js", "dist/steam-api.js", "dist/scope.js", "dist/dev-time.js", "dist/content.js"],
            "css": ["styles/widget.css"],
            "run_at": "document_idle"
        }
    ]
}
